{
  "name": "@howells/starlingcli",
  "version": "0.3.1",
  "description": "CLI for Starling Bank — balances, transactions, payees, standing orders. Agent-first: structured JSON output, multi-account, schema introspection.",
  "keywords": [
    "agent",
    "ai",
    "bank",
    "cli",
    "finance",
    "starling"
  ],
  "homepage": "https://github.com/howells/starlingcli#readme",
  "license": "MIT",
  "author": "Daniel Howells <daniel.howells@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/howells/starlingcli"
  },
  "bin": {
    "starlingcli": "./dist/index.js"
  },
  "files": [
    "dist",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "howells-check .",
    "prepublishOnly": "pnpm build",
    "prepare": "howells-husky",
    "lint:fix": "howells-fix .",
    "lint:ratchet": "howells-ratchet",
    "lint:rebaseline": "howells-ratchet --write",
    "prepush": "pnpm typecheck && pnpm lint:ratchet && pnpm test"
  },
  "dependencies": {
    "@howells/cli": "^0.2.0"
  },
  "devDependencies": {
    "@howells/husky": "^0.2.5",
    "@howells/lint": "^3.5.1",
    "@howells/typescript-config": "^0.1.6",
    "@types/node": "^26.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,jsonc,css,md,mdx}": "howells-oxfmt --write"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.5.2"
}
